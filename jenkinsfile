pipeline {
    agent any

    environment {
        APP_NAME = 'idream'
        WAR_FILE = 'target/idream.war'
        TOMCAT_CONTAINER = 'idream-tomcat'
        TOMCAT_PORT = '8081'
        DEPLOY_DIR = "${WORKSPACE}/deploy"
    }

    stages {
        stage('Check Tools') {
            steps {
                sh '''
                    java -version
                    mvn -version
                    docker --version
                '''
            }
        }

        stage('Git Checkout') {
            steps {
                echo 'Source code is checked out by Jenkins from SCM.'
                sh 'git log -1 --oneline'
            }
        }

        stage('Build WAR') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Verify WAR') {
            steps {
                sh '''
                    test -f "$WAR_FILE"
                    ls -lh "$WAR_FILE"
                '''
                archiveArtifacts artifacts: 'target/idream.war',
                                 fingerprint: true
            }
        }

        stage('Prepare Deployment') {
            steps {
                sh '''
                    mkdir -p "$DEPLOY_DIR"
                    cp "$WAR_FILE" "$DEPLOY_DIR/idream.war"
                    ls -lh "$DEPLOY_DIR/idream.war"
                '''
            }
        }

        stage('Deploy to Tomcat') {
            steps {
                sh '''
                    set -e

                    if ! docker image inspect tomcat:10.1-jdk17-temurin >/dev/null 2>&1; then
                        docker pull tomcat:10.1-jdk17-temurin
                    fi

                    if docker container inspect "$TOMCAT_CONTAINER" >/dev/null 2>&1; then
                        docker rm -f "$TOMCAT_CONTAINER"
                    fi

                    docker run -d \
                        --name "$TOMCAT_CONTAINER" \
                        --restart unless-stopped \
                        -p "$TOMCAT_PORT:8080" \
                        -v "$DEPLOY_DIR:/usr/local/tomcat/webapps" \
                        tomcat:10.1-jdk17-temurin

                    sleep 10
                    docker ps --filter "name=$TOMCAT_CONTAINER"
                    docker logs --tail 50 "$TOMCAT_CONTAINER"
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    set -e
                    test "$(docker inspect -f '{{.State.Running}}' "$TOMCAT_CONTAINER")" = "true"
                    curl --fail --silent --show-error \
                        --retry 10 --retry-delay 3 \
                        "http://localhost:$TOMCAT_PORT/idream/" \
                        -o /dev/null
                    echo "iDream application is responding."
                '''
            }
        }
    }

    post {
        success {
            echo 'iDream application deployed successfully!'
            echo 'Open: http://YOUR_EC2_PUBLIC_IP:8081/idream/'
        }

        failure {
            echo 'Pipeline failed. Check the Console Output.'
        }
    }
}
